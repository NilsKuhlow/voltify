{
  "appId": "de.nilskuhlow.voltify",
  "appName": "Voltify",
  "webDir": "..",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "voltify",
    "hostname": "nilskuhlow.github.io",
    "url": "https://nilskuhlow.github.io/voltify/",
    "allowNavigation": [
      "nilskuhlow.github.io"
    ]
  },
  "ios": {
    "scheme": "Voltify",
    "contentInset": "always",
    "backgroundColor": "#0a0e27",
    "preferredContentMode": "mobile",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0a0e27",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0e27",
      "overlaysWebView": false
    }
  }
}
